diff --git a/src/main/drivers/hx711_math.h b/src/main/drivers/hx711_math.h
new file mode 100644
index 000000000..9d92bd9b2
--- /dev/null
+++ b/src/main/drivers/hx711_math.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+static inline int32_t hx711SignExtend(uint32_t raw)
+{
+    return (int32_t)(raw & 0x7fffff) - (int32_t)(raw & 0x800000);
+}
+
+static inline bool hx711Stable(float mean, float variance, int32_t offset)
+{
+    const float limit = fmaxf(50.0f, fabsf(mean - offset) * 0.005f);
+    return isfinite(mean) && isfinite(variance) && variance >= 0 && variance <= limit * limit;
+}
+
+static inline bool hx711Scale(float mean, float variance, int32_t offset, uint32_t knownMg, float *scale)
+{
+    const float delta = mean - offset;
+    if (!knownMg || knownMg > 500000000 || !hx711Stable(mean, variance, offset) || fabsf(delta) <= fmaxf(10.0f, 10.0f * sqrtf(variance))) {
+        return false;
+    }
+    const float result = delta * 1000.0f / knownMg;
+    if (!isfinite(result) || fabsf(result) < 0.0001f) {
+        return false;
+    }
+    *scale = result;
+    return true;
+}
