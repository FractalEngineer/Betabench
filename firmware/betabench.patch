diff --git a/src/main/drivers/hx711.c b/src/main/drivers/hx711.c
new file mode 100644
index 000000000..dea832988
--- /dev/null
+++ b/src/main/drivers/hx711.c
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <math.h>
+#include <string.h>
+#include "platform.h"
+#ifdef USE_HX711
+#include "common/streambuf.h"
+#include "config/config.h"
+#include "drivers/io.h"
+#include "drivers/time.h"
+#include "drivers/hx711.h"
+#include "drivers/hx711_math.h"
+#include "pg/hx711.h"
+
+static IO_t sck, dout;
+static bool configured, saturated, failed, saved, tared;
+static int32_t raw;
+static uint32_t sequence, lastSampleMs;
+static struct {
+    bool active;
+    uint32_t startMs, knownMg;
+    unsigned count;
+    float mean, m2;
+} capture;
+
+void hx711Init(void)
+{
+    const hx711Config_t *config = hx711Config();
+    sck = IOGetByTag(config->sckTag);
+    dout = IOGetByTag(config->doutTag);
+    if (!sck || !dout || sck == dout || !IOIsFreeOrPreinit(sck) || !IOIsFreeOrPreinit(dout)) {
+        return;
+    }
+    IOInit(sck, OWNER_HX711_SCK, 0);
+    IOInit(dout, OWNER_HX711_DOUT, 0);
+    IOLo(sck);
+    IOConfigGPIO(sck, IOCFG_OUT_PP);
+    IOConfigGPIO(dout, IOCFG_IPU);
+    configured = true;
+    saved = isfinite(config->countsPerGram) && fabsf(config->countsPerGram) >= 0.0001f;
+    // A calibration stored in flash includes a valid tare.
+    tared = saved;
+}
+
+bool hx711Busy(void) { return capture.active; }
+
+void hx711Update(void)
+{
+    const uint32_t now = millis();
+    if (!configured) {
+        return;
+    }
+    if (!IORead(dout)) {
+        uint32_t bits = 0;
+        for (unsigned i = 0; i < 25; i++) {
+            // Protect only each high pulse. HX711 powers down if SCK is high
+            // for >60us. Interrupts remain enabled during conversion waiting.
+            const uint32_t primask = __get_PRIMASK();
+            __disable_irq();
+            IOHi(sck);
+            delayMicroseconds(1);
+            if (i < 24) {
+                bits = (bits << 1) | (IORead(dout) ? 1 : 0);
+            }
+            IOLo(sck);
+            __set_PRIMASK(primask);
+            delayMicroseconds(1);
+        }
+        raw = hx711SignExtend(bits);
+        saturated = raw == -8388608 || raw == 8388607;
+        lastSampleMs = now;
+        sequence++;
+        if (capture.active) {
+            if (saturated) {
+                capture.active = false;
+                failed = true;
+            } else {
+                capture.count++;
+                const float delta = raw - capture.mean;
+                capture.mean += delta / capture.count;
+                capture.m2 += delta * (raw - capture.mean);
+            }
+        }
+    }
+    if (capture.active && (uint32_t)(now - capture.startMs) >= 1000) {
+        capture.active = false;
+        const float variance = capture.count > 1 ? capture.m2 / (capture.count - 1) : 0;
+        failed = capture.count < 8 || (uint32_t)(now - lastSampleMs) > 250 || !hx711Stable(capture.mean, variance, capture.knownMg ? hx711Config()->offset : lrintf(capture.mean));
+        if (!failed) {
+            if (!capture.knownMg) {
+                hx711ConfigMutable()->offset = lrintf(capture.mean);
+                tared = true;
+            } else {
+                float scale;
+                failed = !hx711Scale(capture.mean, variance, hx711Config()->offset, capture.knownMg, &scale);
+                if (!failed) {
+                    hx711ConfigMutable()->countsPerGram = scale;
+                }
+            }
+            if (!failed) {
+                saved = false;
+            }
+        }
+    }
+}
+
+bool hx711Capture(uint32_t knownMg)
+{
+    if (!configured || !sequence || (uint32_t)(millis() - lastSampleMs) > 250 || saturated || capture.active || (knownMg && !tared) || knownMg > 500000000) {
+        return false;
+    }
+    memset(&capture, 0, sizeof(capture));
+    capture.active = true;
+    capture.startMs = millis();
+    capture.knownMg = knownMg;
+    failed = false;
+    return true;
+}
+
+bool hx711Save(void)
+{
+    const hx711Config_t before = *hx711Config();
+    if (!configured || capture.active || failed || !tared || !isfinite(before.countsPerGram) || fabsf(before.countsPerGram) < 0.0001f) {
+        return false;
+    }
+    writeEEPROM();
+    saved = readEEPROM() && hx711Config()->offset == before.offset && hx711Config()->countsPerGram == before.countsPerGram;
+    return saved;
+}
+
+void hx711WriteSample(sbuf_t *dst)
+{
+    const hx711Config_t *config = hx711Config();
+    const uint32_t age = sequence ? (uint32_t)(millis() - lastSampleMs) : UINT32_MAX;
+    const bool calibrated = tared && isfinite(config->countsPerGram) && fabsf(config->countsPerGram) >= 0.0001f;
+    uint8_t flags = (configured ? HX711_CONFIGURED : 0) | (sequence && age <= 250 ? HX711_FRESH : 0) | (calibrated ? HX711_CALIBRATED : 0) | (saturated ? HX711_SATURATED : 0) | (capture.active ? HX711_BUSY : 0) | (failed ? HX711_FAILED : 0) | (saved ? HX711_SAVED : 0);
+    const float mg = calibrated ? ((float)raw - config->offset) * 1000.0f / config->countsPerGram : 0;
+    // Keep invalid or overflowing values out of the signed-milligram field.
+    const int32_t mass = isfinite(mg) && mg > -2147483000.0f && mg < 2147483000.0f ? lrintf(mg) : 0;
+    if (!isfinite(mg) || mg <= -2147483000.0f || mg >= 2147483000.0f) {
+        flags &= ~HX711_CALIBRATED;
+    }
+    sbufWriteU8(dst, flags);
+    sbufWriteU32(dst, raw);
+    sbufWriteU32(dst, mass);
+    sbufWriteU32(dst, sequence);
+    sbufWriteU32(dst, age);
+    sbufWriteU32(dst, config->offset);
+    uint32_t scaleBits;
+    memcpy(&scaleBits, &config->countsPerGram, sizeof(scaleBits));
+    sbufWriteU32(dst, scaleBits);
+}
+#endif
