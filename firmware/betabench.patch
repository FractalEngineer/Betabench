--- /dev/null
+++ b/src/main/fc/betabench.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "platform.h"
+#ifdef USE_BETABENCH
+#include "common/streambuf.h"
+#include "config/feature.h"
+#include "drivers/motor.h"
+#include "drivers/time.h"
+#include "fc/runtime_config.h"
+#include "fc/betabench.h"
+#include "fc/betabench_state.h"
+#include "flight/mixer.h"
+#include "msp/msp_protocol_v2_betaflight.h"
+#include "sensors/battery.h"
+
+static benchState_t state;
+static mspDescriptor_t sessionOwner;
+static uint32_t generation;
+
+static void stopOutputs(void)
+{
+    for (unsigned i = 0; i < getMotorCount(); i++) {
+        motor_disarmed[i] = motorConvertFromExternal(1000);
+    }
+    state.active = false;
+    state.session = 0;
+}
+
+void betabenchInit(void)
+{
+}
+
+bool betabenchLocked(void) { return state.latched; }
+
+void betabenchUpdate(void)
+{
+    if (state.latched) {
+        // Leave inhibition latched after Stop/timeout until power cycling.
+        // This prevents delayed legacy writes or arming-enable messages from
+        // restarting a test. A fresh BENCH_BEGIN can start another session.
+        setArmingDisabled(ARMING_DISABLED_MSP);
+        if (benchExpired(&state, millis()) || ARMING_FLAG(ARMED)) {
+            stopOutputs();
+        }
+    }
+}
+
+mspResult_e betabenchProcess(mspDescriptor_t owner, int16_t command, sbuf_t *src, sbuf_t *dst)
+{
+    const unsigned length = sbufBytesRemaining(src);
+    betabenchUpdate();
+    switch (command) {
+    case MSP2_BENCH_CAPABILITIES:
+        if (length) { return MSP_RESULT_ERROR; }
+        sbufWriteU8(dst, 1);
+        sbufWriteU8(dst, 1);
+        sbufWriteU8(dst, getMotorCount());
+        sbufWriteU16(dst, BETABENCH_TIMEOUT_MS);
+        break;
+    case MSP2_BENCH_BEGIN:
+        if (length || state.active || ARMING_FLAG(ARMED) || !motorIsEnabled() || !isMotorProtocolDshot() || featureIsEnabled(FEATURE_3D)) { return MSP_RESULT_ERROR; }
+        stopOutputs();
+        state.latched = true;
+        state.active = true;
+        state.session = ++generation;
+        if (!state.session) { state.session = ++generation; }
+        state.sequence = 0;
+        state.lastCommandMs = millis();
+        sessionOwner = owner;
+        setArmingDisabled(ARMING_DISABLED_MSP);
+        sbufWriteU32(dst, state.session);
+        break;
+    case MSP2_BENCH_SET_MOTORS: {
+        const unsigned count = getMotorCount();
+        if (length != 9 + count * 2 || owner != sessionOwner || ARMING_FLAG(ARMED)) { return MSP_RESULT_ERROR; }
+        const uint32_t session = sbufReadU32(src);
+        const uint32_t sequence = sbufReadU32(src);
+        if (sbufReadU8(src) != count) { return MSP_RESULT_ERROR; }
+        uint16_t outputs[MAX_SUPPORTED_MOTORS];
+        for (unsigned i = 0; i < count; i++) {
+            outputs[i] = sbufReadU16(src);
+            if (outputs[i] < 1000 || outputs[i] > 2000) { return MSP_RESULT_ERROR; }
+        }
+        if (!benchAccept(&state, session, sequence, millis())) { return MSP_RESULT_ERROR; }
+        for (unsigned i = 0; i < count; i++) {
+            motor_disarmed[i] = motorConvertFromExternal(outputs[i]);
+        }
+        break;
+    }
+    case MSP2_BENCH_STOP:
+        if (length || ARMING_FLAG(ARMED)) { return MSP_RESULT_ERROR; }
+        stopOutputs();
+        break;
+    case MSP2_BENCH_SAMPLE:
+        if (length) { return MSP_RESULT_ERROR; }
+        sbufWriteU8(dst, 1);
+        sbufWriteU8(dst, state.active ? 1 : state.latched ? 2 : 0);
+        sbufWriteU32(dst, state.session);
+        sbufWriteU32(dst, micros());
+        sbufWriteU16(dst, getBatteryVoltage());
+        sbufWriteU16(dst, (int16_t)getAmperage());
+        sbufWriteU8(dst, getMotorCount());
+        for (unsigned i = 0; i < getMotorCount(); i++) {
+            sbufWriteU16(dst, motorConvertToExternal(motor_disarmed[i]));
+        }
+        sbufFill(dst, 0, 25);
+        break;
+    default:
+        return MSP_RESULT_CMD_UNKNOWN;
+    }
+    return MSP_RESULT_ACK;
+}
+#endif
