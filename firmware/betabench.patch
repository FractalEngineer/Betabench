index 000000000..68542afdf
--- /dev/null
+++ b/src/test/betabench/betabench_test.c
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+// Host tests execute the production MSP/session and HX711 code with mocked
+// motors, time, GPIO, flash and battery. No FC hardware is accessed.
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include "platform.h"
+#include "fc/betabench.h"
+#include "fc/betabench_state.h"
+#include "drivers/hx711.h"
+#include "drivers/hx711_math.h"
+#include "drivers/io.h"
+#include "pg/hx711.h"
+#include "msp/msp_protocol_v2_betaflight.h"
+
+static uint32_t now;
+bool testArmed;
+float motor_disarmed[8];
+static bool inhibited;
+static bool ready, clockHigh;
+static uint32_t inputBits;
+static unsigned pulses, reads, owners[3], flashWrites;
+static hx711Config_t config = { 1, 2, 0, 0 };
+static hx711Config_t flash;
+uint32_t millis(void) { return now; }
+uint32_t micros(void) { return now * 1000; }
+void delayMicroseconds(uint32_t us) { assert(us <= 1); }
+bool featureIsEnabled(unsigned feature) { (void)feature; return false; }
+bool motorIsEnabled(void) { return true; }
+bool isMotorProtocolDshot(void) { return true; }
+float motorConvertFromExternal(uint16_t n) { return n; }
+uint16_t motorConvertToExternal(float n) { return n; }
+uint8_t getMotorCount(void) { return 4; }
+bool areMotorsRunning(void) { for (unsigned i=0;i<4;i++) if(motor_disarmed[i] > 1000) return true; return false; }
+void setArmingDisabled(unsigned flag) { (void)flag; inhibited=true; }
+uint16_t getBatteryVoltage(void) { return 1680; }
+int32_t getAmperage(void) { return 1250; }
+const hx711Config_t *hx711Config(void) { return &config; }
+hx711Config_t *hx711ConfigMutable(void) { return &config; }
+void writeEEPROM(void) { flash=config; flashWrites++; }
+bool readEEPROM(void) { config=flash; return true; }
+IO_t IOGetByTag(uint8_t tag) { return tag<3?tag:0; }
+bool IOIsFreeOrPreinit(IO_t io) { return !owners[io]; }
+void IOInit(IO_t io, unsigned owner, unsigned index) { (void)index; owners[io]=owner; }
+void IOConfigGPIO(IO_t io, unsigned cfg) { (void)io; (void)cfg; }
+void IOHi(IO_t io) { (void)io; clockHigh=true; pulses++; }
+void IOLo(IO_t io) { (void)io; clockHigh=false; if(pulses==25) ready=false; }
+bool IORead(IO_t io) { (void)io; if(!clockHigh) return !ready; assert(reads<24); return !!(inputBits & (1u << (23-reads++))); }
+
+// The production serializer contract, with the same little-endian wire format.
+int sbufBytesRemaining(sbuf_t *b) { return b->end-b->ptr; }
+void sbufWriteU8(sbuf_t *b,uint8_t n) { assert(b->ptr<b->end); *b->ptr++=n; }
+void sbufWriteU16(sbuf_t *b,uint16_t n) { sbufWriteU8(b,n);sbufWriteU8(b,n>>8); }
+void sbufWriteU32(sbuf_t *b,uint32_t n) { sbufWriteU16(b,n);sbufWriteU16(b,n>>16); }
+void sbufFill(sbuf_t *b,uint8_t n,int length) { while(length--)sbufWriteU8(b,n); }
+uint8_t sbufReadU8(sbuf_t *b) { assert(b->ptr<b->end);return *b->ptr++; }
+uint16_t sbufReadU16(sbuf_t *b) { uint16_t n=sbufReadU8(b);return n|((uint16_t)sbufReadU8(b)<<8); }
+uint32_t sbufReadU32(sbuf_t *b) { uint32_t n=sbufReadU16(b);return n|((uint32_t)sbufReadU16(b)<<16); }
+
+static uint8_t reply[256];
+static unsigned replyLength;
+static mspResult_e call(unsigned owner, int16_t command, uint8_t *data, unsigned length)
+{
+    uint8_t empty=0;
+    sbuf_t src={data?data:&empty,(data?data:&empty)+length};
+    sbuf_t dst={reply,reply+sizeof(reply)};
+    const mspResult_e result=betabenchProcess(owner,command,&src,&dst);
+    replyLength=dst.ptr-reply;
+    return result;
+}
+static uint32_t get32(unsigned offset) { sbuf_t b={reply+offset,reply+replyLength};return sbufReadU32(&b); }
+static void feed(int32_t raw) { inputBits=(uint32_t)raw&0xffffff;ready=true;pulses=reads=0;hx711Update();assert(pulses==25&&reads==24); }
+static void capture(int32_t base) { for(unsigned i=0;i<11;i++){now+=100;feed(base+(int32_t)(i%3)-1);} }
+
+int main(void)
+{
+    assert(hx711SignExtend(0xffffff)==-1);
+    assert(hx711SignExtend(0x800000)==-8388608);
+    assert(hx711SignExtend(0x7fffff)==8388607);
+    float scale=999;
+    assert(!hx711Scale(10,1,10,100000,&scale)&&scale==999);
+    assert(!hx711Scale(1000,100000,0,100000,&scale)&&scale==999);
+    assert(hx711Scale(-42000,1,0,100000,&scale)&&fabsf(scale+420)<0.01f);
+
+    benchState_t wrap={.session=1,.sequence=1,.lastCommandMs=UINT32_MAX-100,.active=true};
+    assert(!benchExpired(&wrap,398));assert(benchExpired(&wrap,399));
+    assert(!benchAccept(&wrap,2,2,0));assert(!benchAccept(&wrap,1,1,0));
+
+    // Identical and already-owned GPIO resources must not initialize.
+    config.doutTag=1;hx711Init();
+    uint8_t hxData[25];sbuf_t hxBuf={hxData,hxData+25};hx711WriteSample(&hxBuf);
+    assert(!(hxData[0]&HX711_CONFIGURED));
+    config.doutTag=2;owners[1]=99;hx711Init();
+    hxBuf=(sbuf_t){hxData,hxData+25};hx711WriteSample(&hxBuf);
+    assert(!(hxData[0]&HX711_CONFIGURED));owners[1]=0;
+    betabenchInit();
+    assert(call(1,MSP2_BENCH_CAPABILITIES,NULL,0)==MSP_RESULT_ACK&&replyLength==5);
+    assert(reply[0]==1&&reply[1]==3&&reply[2]==4);
+    testArmed=true;assert(call(1,MSP2_BENCH_BEGIN,NULL,0)==MSP_RESULT_ERROR);testArmed=false;
+    assert(call(1,MSP2_BENCH_BEGIN,NULL,0)==MSP_RESULT_ACK);const uint32_t session=get32(0);
+    assert(inhibited&&betabenchLocked());
+    uint8_t values[17];sbuf_t b={values,values+sizeof(values)};
+    sbufWriteU32(&b,session);sbufWriteU32(&b,1);sbufWriteU8(&b,4);
+    for(unsigned i=0;i<4;i++)sbufWriteU16(&b,1500);
+    assert(call(2,MSP2_BENCH_SET_MOTORS,values,17)==MSP_RESULT_ERROR);
+    assert(call(1,MSP2_BENCH_SET_MOTORS,values,16)==MSP_RESULT_ERROR);
+    values[10]=255;assert(call(1,MSP2_BENCH_SET_MOTORS,values,17)==MSP_RESULT_ERROR);values[10]=5;
+    assert(call(1,MSP2_BENCH_SET_MOTORS,values,17)==MSP_RESULT_ACK&&motor_disarmed[0]==1500);
+    assert(call(1,MSP2_BENCH_SET_MOTORS,values,17)==MSP_RESULT_ERROR);
+    for(unsigned i=1;i<=5;i++){now=i*100;assert(call(1,MSP2_BENCH_SAMPLE,NULL,0)==MSP_RESULT_ACK);assert(replyLength==48);}
+    assert(motor_disarmed[0]==1000&&get32(2)==0);
+    assert(call(1,MSP2_BENCH_SET_MOTORS,values,17)==MSP_RESULT_ERROR);
+    assert(call(1,MSP2_BENCH_BEGIN,NULL,0)==MSP_RESULT_ACK&&get32(0)!=session);
+    assert(call(1,MSP2_BENCH_STOP,NULL,0)==MSP_RESULT_ACK);
+    assert(betabenchLocked());
+
+    feed(100);
+    assert(call(1,MSP2_HX711_TARE,NULL,0)==MSP_RESULT_ACK);capture(100);
+    assert(config.offset==100&&flashWrites==0);
+    uint8_t mass[4];b=(sbuf_t){mass,mass+4};sbufWriteU32(&b,100000);
+    assert(call(1,MSP2_HX711_CALIBRATE,mass,4)==MSP_RESULT_ACK);
+    assert(call(1,MSP2_BENCH_BEGIN,NULL,0)==MSP_RESULT_ERROR);
+    capture(42100);assert(fabsf(config.countsPerGram-420)<0.01f&&flashWrites==0);
+    assert(call(1,MSP2_HX711_SAVE_CALIBRATION,NULL,0)==MSP_RESULT_ACK&&flashWrites==1);
+    config.countsPerGram=0;assert(readEEPROM()&&fabsf(config.countsPerGram-420)<0.01f);
+    assert(call(1,MSP2_HX711_CALIBRATE,mass,4)==MSP_RESULT_ACK);now+=1100;hx711Update();
+    assert(fabsf(config.countsPerGram-420)<0.01f);
+    assert(call(1,MSP2_BENCH_SAMPLE,NULL,0)==MSP_RESULT_ACK);
+    assert(reply[23]&HX711_FAILED);assert(!(reply[23]&HX711_FRESH));
+    feed(8388607);assert(call(1,MSP2_HX711_TARE,NULL,0)==MSP_RESULT_ERROR);
+    feed(100);assert(call(1,MSP2_HX711_TARE,NULL,0)==MSP_RESULT_ACK);
+    for(unsigned i=0;i<11;i++){now+=100;feed(i%2?3100:-2900);}
+    assert(config.offset==100); // An unstable tare preserves the previous zero.
+    assert(call(1,MSP2_HX711_CALIBRATE,mass,4)==MSP_RESULT_ACK);
+    capture(-41900);assert(fabsf(config.countsPerGram+420)<0.01f);
+    assert(call(1,MSP2_HX711_SAVE_CALIBRATION,NULL,0)==MSP_RESULT_ACK&&flashWrites==2);
+    uint8_t zeroMass[4]={0};assert(call(1,MSP2_HX711_CALIBRATE,zeroMass,4)==MSP_RESULT_ERROR);
+    puts("PASS: production session/watchdog/MSP and HX711 GPIO/capture/calibration/persistence");
+    return 0;
+}
