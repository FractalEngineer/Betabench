--- /dev/null
+++ b/src/main/fc/betabench_state.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+#define BETABENCH_TIMEOUT_MS 500
+typedef struct benchState_s {
+    uint32_t session;
+    uint32_t sequence;
+    uint32_t lastCommandMs;
+    bool active;
+    bool latched;
+} benchState_t;
+
+static inline bool benchExpired(const benchState_t *s, uint32_t now)
+{
+    return s->active && (uint32_t)(now - s->lastCommandMs) >= BETABENCH_TIMEOUT_MS;
+}
+
+static inline bool benchAccept(benchState_t *s, uint32_t session, uint32_t sequence, uint32_t now)
+{
+    if (!s->active || s->session != session || (int32_t)(sequence - s->sequence) <= 0 || benchExpired(s, now)) {
+        return false;
+    }
+    s->sequence = sequence;
+    s->lastCommandMs = now;
+    return true;
+}
